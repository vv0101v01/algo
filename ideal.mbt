///|
/// An ideal of the polynomial ring `𝔽_m[x_0, ..., x_{n-1}]`, given by
/// generators. All structural questions (containment, equality, primality,
/// conductor, radical membership) are answered through Gröbner bases and
/// linear algebra — never by enumeration of infinite element sets.
pub(all) struct PolyIdeal {
  nvars : Int32
  modulus : Int32
  gens : Array[Poly]
} derive(Debug)

///|
/// Construct an ideal from generators (validated against the ambient ring).
pub fn PolyIdeal::new(
  nvars : Int32,
  modulus : Int32,
  gens : Array[Poly],
) -> PolyIdeal {
  for g in gens {
    if g.nvars != nvars || g.modulus != modulus {
      abort("PolyIdeal::new: generator ambient mismatch")
    }
  }
  PolyIdeal::{ nvars, modulus, gens, }
}

///|
/// The zero ideal `⟨⟩ = {0}`.
pub fn PolyIdeal::zero(nvars : Int32, modulus : Int32) -> PolyIdeal {
  PolyIdeal::{ nvars, modulus, gens: [], }
}

///|
/// The unit ideal `⟨1⟩ = R`.
pub fn PolyIdeal::unit(nvars : Int32, modulus : Int32) -> PolyIdeal {
  PolyIdeal::{ nvars, modulus, gens: [Poly::one(nvars, modulus)], }
}

///|
/// The principal ideal `⟨f⟩`.
pub fn PolyIdeal::principal(f : Poly) -> PolyIdeal {
  PolyIdeal::{ nvars: f.nvars, modulus: f.modulus, gens: [f], }
}

///|
/// The reduced monic Gröbner basis of the ideal (canonical representation).
pub fn PolyIdeal::gb(self : Self) -> Array[Poly] {
  groebner_basis(self.gens)
}

///|
/// Membership test `f ∈ I` via normal forms.
pub fn PolyIdeal::contains(self : Self, f : Poly) -> Bool {
  ideal_membership(f, self.gens)
}

///|
/// Sum of ideals `I + J = { a + b | a ∈ I, b ∈ J }` (generated by the union).
pub fn PolyIdeal::add(self : Self, other : PolyIdeal) -> PolyIdeal {
  if self.nvars != other.nvars || self.modulus != other.modulus {
    abort("PolyIdeal::add: ambient mismatch")
  }
  let gens : Array[Poly] = []
  for g in self.gens {
    gens.push(g)
  }
  for g in other.gens {
    gens.push(g)
  }
  PolyIdeal::{ nvars: self.nvars, modulus: self.modulus, gens, }
}

///|
/// Product of ideals `I·J = { Σ a_k b_k | a_k ∈ I, b_k ∈ J }`.
pub fn PolyIdeal::mul(self : Self, other : PolyIdeal) -> PolyIdeal {
  if self.nvars != other.nvars || self.modulus != other.modulus {
    abort("PolyIdeal::mul: ambient mismatch")
  }
  let gens : Array[Poly] = []
  for a in self.gens {
    for b in other.gens {
      gens.push(a.mul(b))
    }
  }
  PolyIdeal::{ nvars: self.nvars, modulus: self.modulus, gens, }
}

///|
/// Ideal equality by mutual containment (Gröbner canonical forms coincide).
pub fn PolyIdeal::eq(self : Self, other : PolyIdeal) -> Bool {
  if self.nvars != other.nvars || self.modulus != other.modulus {
    return false
  }
  let (ga, gb) = (self.gb(), other.gb())
  // reduced monic bases are unique: compare as sets of polynomials
  if ga.length() != gb.length() {
    return false
  }
  for a in ga {
    let mut found = false
    for b in gb {
      if a == b {
        found = true
      }
    }
    if !found {
      return false
    }
  }
  true
}

///|
/// Is `I` zero-dimensional? (finite coordinate ring `k[x]/I`)
pub fn PolyIdeal::is_zero_dim(self : Self) -> Bool {
  is_zero_dim(self.gens)
}

///|
/// A `𝔽_p`-basis of `k[x]/I`, or `None` if the quotient is infinite.
pub fn PolyIdeal::standard_monomials(self : Self) -> Array[Array[Int32]]? {
  standard_monomials(self.gens)
}

///|
/// Radical membership `f ∈ √I` via Rabinowitsch.
pub fn PolyIdeal::radical_membership(self : Self, f : Poly) -> Bool {
  radical_membership(f, self.gens)
}

///|
/// Intersection `I ∩ J` by the elimination (t-trick) construction:
/// with a new variable `t`, `I ∩ J = ( t·I + (1 − t)·J ) ∩ k[x]`,
/// computed from the Gröbner basis of `t·I + (1−t)·J` in lex order
/// `t > x_0 > ...` by dropping every basis element involving `t`.
pub fn PolyIdeal::intersect(self : Self, other : PolyIdeal) -> PolyIdeal {
  if self.nvars != other.nvars || self.modulus != other.modulus {
    abort("PolyIdeal::intersect: ambient mismatch")
  }
  let n = self.nvars + 1
  let m = self.modulus
  let tI : Array[Poly] = []
  for g in self.gens {
    let raw : Array[(Int32, Array[Int32])] = []
    for t in g.terms {
      let e : Array[Int32] = [1]
      for x in t.exp {
        e.push(x)
      }
      raw.push((t.coeff.val, e))
    }
    tI.push(poly_of_terms(n, m, raw))
  }
  let otJ : Array[Poly] = []
  for g in other.gens {
    let raw : Array[(Int32, Array[Int32])] = []
    for t in g.terms {
      let e0 : Array[Int32] = [0]
      let e1 : Array[Int32] = [1]
      for x in t.exp {
        e0.push(x)
        e1.push(x)
      }
      raw.push((t.coeff.val, e0))
      raw.push((-t.coeff.val, e1))
    }
    otJ.push(poly_of_terms(n, m, raw))
  }
  let kgens : Array[Poly] = []
  for g in tI {
    kgens.push(g)
  }
  for g in otJ {
    kgens.push(g)
  }
  let bk = groebner_basis(kgens)
  // elimination: keep generators free of t (t = x_0)
  let out : Array[Poly] = []
  for g in bk {
    let mut has_t = false
    for t in g.terms {
      if t.exp[0] != 0 {
        has_t = true
      }
    }
    if !has_t {
      // strip the leading t coordinate, back to nvars variables
      let raw : Array[(Int32, Array[Int32])] = []
      for t in g.terms {
        let e : Array[Int32] = []
        for k in 1..<n {
          e.push(t.exp[k])
        }
        raw.push((t.coeff.val, e))
      }
      out.push(poly_of_terms(self.nvars, m, raw))
    }
  }
  PolyIdeal::{ nvars: self.nvars, modulus: m, gens: out, }
}

///|
/// Residual (conductor) ideal for a *principal* second argument:
/// `(I : g) = { f ∈ R | f·g ∈ I }`.
/// Algorithm (requires `I` zero-dimensional): coordinates of `k[x]/I` on the
/// standard monomial basis; multiplication-by-`g` is a matrix `M_g`, and
/// `(I : g) = I + ⟨ lift(ker M_g) ⟩` — the kernel of a linear map.
/// Theorem: `f·g ∈ I ⇔ [f] ∈ ker M_g` in the quotient.
pub fn PolyIdeal::quotient_principal(self : Self, g : Poly) -> PolyIdeal? {
  if g.nvars != self.nvars || g.modulus != self.modulus {
    abort("PolyIdeal::quotient_principal: ambient mismatch")
  }
  let basis = match standard_monomials(self.gens) {
    Some(b) => b
    None => return None // infinite quotient: kernel not computable this way
  }
  let gb = self.gb()
  let d = basis.length()
  let mat = @linalg.Matrix::zero(self.modulus, d, d)
  // M[i][j] = coordinate i of the normal form of g · m_j
  for j in 0..<d {
    let raw : Array[(Int32, Array[Int32])] = []
    for t in g.terms {
      raw.push((t.coeff.val, exp_add(t.exp, basis[j])))
    }
    let prod = poly_of_terms(self.nvars, self.modulus, raw)
    let red = prod.normal_form(gb)
    for t in red.terms {
      let mut idx = -1
      for i in 0..<d {
        if lex_cmp(basis[i], t.exp) == 0 {
          idx = i
        }
      }
      if idx == -1 {
        abort("quotient_principal: normal form left the standard monomial span")
      }
      mat.data[idx][j] = t.coeff.val
    }
  }
  let ker = mat.nullspace()
  let out : Array[Poly] = []
  for g0 in self.gens {
    out.push(g0)
  }
  for v in ker {
    let raw : Array[(Int32, Array[Int32])] = []
    for i in 0..<d {
      if v[i] != 0 {
        raw.push((v[i], basis[i]))
      }
    }
    let lift = poly_of_terms(self.nvars, self.modulus, raw)
    if !lift.is_zero() {
      out.push(lift)
    }
  }
  Some(PolyIdeal::{ nvars: self.nvars, modulus: self.modulus, gens: out, })
}

///|
/// Residual (conductor) ideal `(I : J) = { r ∈ R | r·J ⊆ I } = ∩_{g ∈ gens(J)} (I : g)`.
/// Requires `I` zero-dimensional (each principal quotient is computed by
/// linear algebra); returns `None` otherwise. If `J = ⟨⟩ = {0}`, the conductor
/// is the whole ring `R`.
pub fn PolyIdeal::conductor(self : Self, other : PolyIdeal) -> PolyIdeal? {
  if self.nvars != other.nvars || self.modulus != other.modulus {
    abort("PolyIdeal::conductor: ambient mismatch")
  }
  if other.gens.length() == 0 {
    return Some(PolyIdeal::unit(self.nvars, self.modulus))
  }
  let mut acc : PolyIdeal? = None
  for g in other.gens {
    let q = match self.quotient_principal(g) {
      Some(q) => q
      None => return None
    }
    acc = Some(
      match acc {
        None => q
        Some(a) => a.intersect(q)
      },
    )
  }
  acc
}

///|
/// Is the zero-dimensional ideal `I` prime (equivalently maximal: a
/// `0`-dimensional ring has no non-maximal primes)? Criterion: the finite
/// quotient `R = k[x]/I` is an integral domain; since `R` is finite,
/// domain ⇔ field ⇔ every nonzero `a` has `M_a` invertible, where `M_a` is
/// multiplication-by-`a` on the standard-monomial basis. `M_a` singular ⇔
/// `a` is a zero divisor — checked exactly by rank over `𝔽_p`.
/// Theorem: for `0`-dimensional `I`: prime ⇔ maximal ⇔ `k[x]/I` is a field.
pub fn PolyIdeal::is_prime(self : Self) -> Bool {
  let basis = match standard_monomials(self.gens) {
    Some(b) => b
    None => return false // undecided for infinite quotients; see README
  }
  let gb = self.gb()
  let d = basis.length()
  let p = self.modulus
  // structure matrices S_i = multiplication-by-m_i on the basis
  let structs : Array[@linalg.Matrix] = []
  for i in 0..<d {
    let si = @linalg.Matrix::zero(p, d, d)
    for j in 0..<d {
      let e : Array[Int32] = []
      for k in 0..<self.nvars {
        e.push(basis[i][k] + basis[j][k])
      }
      let prod = poly_of_terms(self.nvars, self.modulus, [(1, e)])
      let red = prod.normal_form(gb)
      for t in red.terms {
        let mut idx = -1
        for r in 0..<d {
          if lex_cmp(basis[r], t.exp) == 0 {
            idx = r
          }
        }
        if idx == -1 {
          abort("is_prime: normal form left the standard monomial span")
        }
        si.data[idx][j] = t.coeff.val
      }
    }
    structs.push(si)
  }
  // enumerate all nonzero elements a = Σ a_i m_i of the quotient
  let total = @num.power_int(p, d)
  if total > 20000 {
    abort("is_prime: quotient too large for exhaustive unit test")
  }
  for code in 1..<total {
    // M_a = Σ a_i · S_i
    let ma = @linalg.Matrix::zero(p, d, d)
    let mut x = code
    for i in 0..<d {
      let ai = @num.mod_pos(x, p)
      x = x / p
      if ai != 0 {
        for r in 0..<d {
          for c in 0..<d {
            ma.data[r][c] = @num.mod_pos(
              ma.data[r][c] + @num.mul_mod(ai, structs[i].data[r][c], p),
              p,
            )
          }
        }
      }
    }
    if ma.rank() < d {
      return false // a is a zero divisor: R is not a domain
    }
  }
  true
}
