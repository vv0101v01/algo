// Whitebox tests for the modules package: assertion + property tests.
// Covers: cyclic modules, annihilators, free/projective modules (dual basis),
// the idempotent-summand flagship, split/non-split extensions, presentations.

///|
fn dual_numbers() -> @finite.FinAlg {
  // 𝔽₂[x]/(x²)
  @finite.FinAlg::univariate_quotient(2, [0, 0, 1])
}

///|
fn f2four() -> @finite.FinAlg {
  // 𝔽₂[x,y]/(x²+x, y²+y) ≅ 𝔽₂⁴
  @finite.FinAlg::zero_dim_quotient(2, [
    @poly.poly_of_terms(2, 2, [(1, [2, 0]), (1, [1, 0])]),
    @poly.poly_of_terms(2, 2, [(1, [0, 2]), (1, [0, 1])]),
  ])
}

///|
fn cusp5() -> @finite.FinAlg {
  // 𝔽₅[x,y]/(x², xy, y²)
  @finite.FinAlg::zero_dim_quotient(5, [
    @poly.poly_of_terms(2, 5, [(1, [2, 0])]),
    @poly.poly_of_terms(2, 5, [(1, [1, 1])]),
    @poly.poly_of_terms(2, 5, [(1, [0, 2])]),
  ])
}

///|

///|
test "free modules: structure, laws, ranks" {
  let r = dual_numbers()
  let f1 = FinModule::free(r, 1)
  assert_true(f1.validate())
  assert_true(f1.dim == 2)
  let f2 = FinModule::free(r, 2)
  assert_true(f2.validate())
  assert_true(f2.dim == 4)
  assert_true(is_free(f1))
  assert_true(is_free(f2))
  assert_true(is_projective(f1))
  // End_R(R) ≅ R: the Hom-space of R into itself has dim_R elements
  assert_true(hom_space(f1, f1).length() == 2)
}

///|
test "cyclic modules: R/I, annihilator round-trip, coherence" {
  let r = dual_numbers()
  let x = [0, 1]
  let ix = r.principal_ideal(x)
  // M = R/(x) ≅ 𝔽₂
  let m = FinModule::cyclic(ix)
  assert_true(m.validate())
  assert_true(m.dim == 1)
  // Theorem: Ann(R/I) = I  →  annihilator round-trip
  let ann = m.annihilator()
  assert_true(ann.length() == 2)
  assert_true(@linalg.elems_contains(ann, x))
  assert_false(@linalg.elems_contains(ann, r.one_elem()))
  // R/(0) = R is free of rank 1
  let m0 = FinModule::cyclic(r.zero_ideal())
  assert_true(m0.validate())
  assert_true(m0.dim == 2)
  assert_true(is_free(m0))
  // presentation of R/(x): one generator, relation lattice rank = n−dim = 1
  let gens = m.generators()
  assert_true(gens.length() == 1)
  let rel = m.relations(gens)
  assert_true(rel.length() == 1)
  assert_true(m.is_coherent())
}

///|
test "projective vs free: idempotent summand 𝔽₂⁴ flagship" {
  let r = f2four()
  let prims = @finite.primitive_idempotents(r)
  assert_true(prims.length() == 4)
  let e = prims[0]
  // ideal generated by an idempotent is a direct summand ⇒ projective
  let ie = r.principal_ideal(e)
  let m = FinModule::cyclic(ie)
  assert_true(m.validate())
  assert_true(is_projective(m))
  // ...but dim(eR) = 1 ≠ 4 = dim R: NOT free (over 𝔽₂⁴, projective ⇏ free)
  assert_false(is_free(m))
  // R itself is free of rank 1
  let fr = FinModule::free(r, 1)
  assert_true(is_projective(fr))
  assert_true(is_free(fr))
  // R/(1−e) ≅ eR: also projective, not free
  let comp = @linalg.vec_add(r.p, r.one_elem(), @linalg.vec_scale(r.p, -1, e))
  let mq = FinModule::cyclic(r.principal_ideal(comp))
  assert_true(mq.validate())
  assert_true(is_projective(mq))
  assert_false(is_free(mq))
}

///|
test "over a local ring projective ⇔ free: 𝔽₂[x]/(x²)" {
  let r = dual_numbers()
  // R/(x) has dim 1, not a multiple of 2 → not projective (proj = free locally)
  let m = FinModule::cyclic(r.principal_ideal([0, 1]))
  assert_true(m.validate())
  assert_false(is_projective(m))
  // every free module satisfies dual basis
  let f3 = FinModule::free(r, 3)
  assert_true(is_projective(f3))
  assert_true(is_free(f3))
}

///|
test "submodules, quotient modules, non-split extension (continuous module)" {
  let r = dual_numbers()
  let e = FinModule::free(r, 1) // R as module
  // submodules of R = ideals: 3 of them
  let subs = enumerate_submodules(e)
  assert_true(subs.length() == 3)
  // N = (x) ⊆ R: the sequence 0 → (x) → R → R/(x) → 0 does NOT split
  let nx = r.principal_ideal([0, 1]).members
  assert_true(e.is_submodule(nx))
  assert_false(is_split_extension(e, nx))
  // while 0 → (0) → R splits trivially
  assert_true(is_split_extension(e, r.zero_ideal().members))
  // quotient module R/(x): dim 1, same annihilator as the cyclic module
  let q = e.quotient_module(nx)
  assert_true(q.validate())
  assert_true(q.dim == 1)
  let mc = FinModule::cyclic(r.principal_ideal([0, 1]))
  assert_true(@linalg.elems_eq(q.annihilator(), mc.annihilator()))
}

///|
test "cusp module: annihilator of R/(x,y) is the maximal ideal" {
  let r = cusp5()
  let m = @finite.nilradical(r)
  let cm = FinModule::cyclic(m)
  assert_true(cm.validate())
  assert_true(cm.dim == 1)
  let ann = cm.annihilator()
  assert_true(ann.length() == 25)
  // generators/relations presentation is exact
  let gens = cm.generators()
  assert_true(gens.length() == 1)
  assert_true(cm.relations(gens).length() == 1 * 3 - 1)
  assert_true(cm.is_coherent())
  // R free & projective
  let fr = FinModule::free(r, 1)
  assert_true(is_projective(fr))
  assert_true(is_free(fr))
}

// ---------- property tests ----------

///|

///|

///|

///|
test "property: free modules are projective, validated, with right rank" {
  @quickcheck.check((seed : Int32) => {
    let s = @num.mod_pos(seed, 100000)
    let r = @testutil.prop_ring(s, [2, 3])
    let n = 1 + @testutil.det_rand(s, 40) % 2
    let f = FinModule::free(r, n)
    let ok1 = f.validate()
    let ok2 = f.dim == n * r.dim
    let ok3 = is_projective(f)
    let ok4 = is_free(f)
    ok1 && ok2 && ok3 && ok4
  })
}

///|
test "property: annihilator of the cyclic module R/I really annihilates" {
  @quickcheck.check((seed : Int32) => {
    let s = @num.mod_pos(seed, 100000)
    let r = @testutil.prop_ring(s, [2, 3])
    let g = @testutil.prop_elem(s, 7, r.p, r.dim)
    let ideal = r.principal_ideal(g)
    if ideal.contains(r.one_elem()) {
      true // unit generator skipped (zero quotient)
    } else {
      let m = FinModule::cyclic(ideal)
      let ok_v = m.validate()
      let ann = m.annihilator()
      let mut ok_a = true
      let all = @linalg.enumerate_vectors(r.p, m.dim)
      for a in ann {
        // element map x ↦ a·x must vanish identically
        let act = @linalg.Matrix::zero(r.p, m.dim, m.dim)
        for i in 0..<r.dim {
          if a[i] == 0 {
            continue
          }
          for u in 0..<m.dim {
            for v in 0..<m.dim {
              let t = (act.data[u][v] + a[i] * m.action[i].data[u][v]) % r.p
              act.data[u][v] = @num.mod_pos(t, r.p)
            }
          }
        }
        for x in all {
          if !@testutil.is_zero_vec(act.apply(x)) {
            ok_a = false
          }
        }
      }
      ok_v && ok_a
    }
  })
}

///|
test "property: dim(M/N) = dim M − dim N for random principal submodules" {
  @quickcheck.check((seed : Int32) => {
    let s = @num.mod_pos(seed, 100000)
    let r = @testutil.prop_ring(s, [2, 3])
    // submodule = principal ideal inside the regular module R
    let g = @testutil.prop_elem(s, 9, r.p, r.dim)
    let sub = r.principal_ideal(g).members
    let e = FinModule::free(r, 1)
    let q = e.quotient_module(sub)
    let ok1 = q.validate()
    let ok2 = q.dim == r.dim - ideal_rank(r, sub)
    ok1 && ok2
  })
}

///|
fn ideal_rank(r : @finite.FinAlg, members : Array[Array[Int32]]) -> Int32 {
  if members.length() == 0 {
    return 0
  }
  @linalg.Matrix::from_rows(r.p, members).rank()
}

///|
test "dual module dims: Hom(R^n,R) ≅ R^n and Hom(R/I,R) ≅ Ann(I) (assertions)" {
  let r4 = f2four() // 域維2（若為4元域 dim=2）
  let d1 = dual_dim(FinModule::free(r4, 1))
  assert_eq(d1, r4.dim)
  let d2 = dual_dim(FinModule::free(r4, 2))
  assert_eq(d2, 2 * r4.dim)
  // 循環模對偶 = 零化子：dim_k Hom(R/I,R) = dim_k Ann(I)
  let nd = dual_numbers() // 𝔽₂[x]/(x²)（對偶數）
  let i = nd.principal_ideal([0, 1]) // (x)
  let m = FinModule::cyclic(i)
  assert_eq(dual_dim(m), ideal_kdim(@finite.annihilator_ideal(i)))
}

///|
test "torsion submodule: free over domain ⟺ torsion-free, zero-divisor cases (assertions)" {
  // 域（有限整環）上自由模扭率自由 — 定理：free₁ 扭率自由 ⟺ R 無零因子
  let fld = @finite.FinAlg::univariate_quotient(2, [1, 1, 1]) // 𝔽₄
  assert_true(is_torsion_free(FinModule::free(fld, 1)))
  // 有零因子的環（𝔽₂⁴ 含非平凡冪等元 e）：(1−e)·e = 0 ⇒ e 扭率
  let r4 = f2four()
  assert_true(!is_torsion_free(FinModule::free(r4, 1)))
  // 𝔽₂[x]/(x²)：自由模 R 有扭率元 x（x·x = 0）
  let nd = dual_numbers()
  assert_true(!is_torsion_free(FinModule::free(nd, 1)))
  // 循環模 R/(x)：所有元素被 x 零化 → 全扭率
  let m = FinModule::cyclic(nd.principal_ideal([0, 1]))
  assert_true(!is_torsion_free(m))
  assert_eq(torsion_elements(m).length(), @num.power_int(nd.p, m.dim))
}

///|
test "inverse limits (continuous modules): threads, surjectivity, injectivity (assertions)" {
  // X0(2) ← X1(4) ← X2(4)
  let sys = InvSystem::{
    sizes: [2, 4, 4],
    bonds: [[0, 1, 0, 1], [0, 1, 2, 3]],
  }
  assert_true(sys.validate())
  assert_eq(sys.limit_threads().length(), 4) // |lim| = |頂層|
  assert_true(sys.projection_surjective(0))
  assert_true(sys.projection_surjective(1))
  assert_true(sys.bond_injective(1))
  assert_true(!sys.bond_injective(0)) // [0,1,0,1] 非單射
  // 非法系統：鍵數不匹配
  let bad = InvSystem::{ sizes: [2, 4], bonds: [[0, 1, 0]], }
  assert_true(!bad.validate())
}

///|
test "module sheaf localization: identity axiom, torsion vanishing, zero (assertions)" {
  // R = 𝔽₂[x]/(x²)，M = R（自由1）
  let nd = dual_numbers()
  let m = FinModule::free(nd, 1)
  let one = nd.one_elem()
  // 恆等限制：g = 1 ⇒ |M₁| = |M| = 4
  assert_eq(mod_localize_size(m, one), 4)
  // g = 0 ⇒ M₀ = 0（單類）
  assert_eq(mod_localize_size(m, nd.zero_elem()), 1)
  // g = x 幂零 ⇒ M_x = 0（x^2·M = 0 且 x·M 殺剩餘）
  assert_eq(mod_localize_size(m, [0, 1]), 1)
  // 𝔽₄（域）上自由模在單位 g 處局部化不變
  let f4 = f2four()
  if @finite.is_field_alg(f4) {
    let mf = FinModule::free(f4, 1)
    assert_eq(
      mod_localize_size(mf, f4.one_elem()),
      @num.power_int(f4.p, f4.dim),
    )
    // g = x（非零 → 單位）：局部化大小 = |M|
    let sz = mod_localize_size(mf, [0, 1])
    assert_eq(sz, @num.power_int(f4.p, f4.dim))
  }
  // 類標記：g=1 時不同元素類不同
  let c0 = mod_localize_class_of(m, one, [0, 0])
  let c1 = mod_localize_class_of(m, one, [1, 0])
  assert_true(c0 != c1)
}
