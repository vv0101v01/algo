///|
/// An ideal of a finite algebra: an `𝔽_p`-subspace of the element space
/// closed under multiplication by every basis element.
/// Canonical representation: the normalized, sorted list of all members.
pub(all) struct FinIdeal {
  alg : FinAlg
  members : Array[Array[Int32]]
} derive(Debug)

///|
/// The zero ideal `{0}`.
pub fn FinAlg::zero_ideal(self : Self) -> FinIdeal {
  FinIdeal::{ alg: self, members: [self.zero_elem()], }
}

///|
/// The unit ideal `R` (every element).
pub fn FinAlg::unit_ideal(self : Self) -> FinIdeal {
  FinIdeal::{
    alg: self,
    members: @linalg.elems_normalize(self.p, self.all_elements()),
  }
}

///|
/// The principal ideal `⟨a⟩ = R·a` (the image of multiplication by `a`,
/// which is already an `𝔽_p`-subspace closed under the ring action).
pub fn FinAlg::principal_ideal(self : Self, a : Array[Int32]) -> FinIdeal {
  let out : Array[Array[Int32]] = []
  for r in self.all_elements() {
    out.push(self.mul_elem(r, a))
  }
  FinIdeal::{ alg: self, members: @linalg.elems_normalize(self.p, out), }
}

///|
/// Membership test `x ∈ I` (binary search on the canonical member list).
pub fn FinIdeal::contains(self : Self, x : Array[Int32]) -> Bool {
  @linalg.elems_contains(self.members, x)
}

///|
/// Ideals containing a given set of elements: the closure of the span under
/// the ring action — the ideal generated by the set.
pub fn FinIdeal::generate(alg : FinAlg, gens : Array[Array[Int32]]) -> FinIdeal {
  let sp = @linalg.span_elements(alg.p, gens)
  let closed = @linalg.close_under_actions(alg.p, sp, alg.mult)
  FinIdeal::{ alg, members: closed, }
}

///|
/// Enumerate *all* ideals of the algebra by closure-system BFS over
/// `𝔽_p`-subspaces invariant under all multiplication maps.
/// Theorem: ideals of a finite `𝔽_p`-algebra are exactly the
/// action-closed subspaces — so this list is exhaustive.
pub fn enumerate_ideals(alg : FinAlg) -> Array[FinIdeal] {
  let spaces = @linalg.enumerate_closed_subspaces(alg.p, alg.dim, alg.mult)
  let out : Array[FinIdeal] = []
  for members in spaces {
    out.push(FinIdeal::{ alg, members, })
  }
  out
}

///|
/// Sum of ideals `I + J = ⟨I ∪ J⟩`.
pub fn FinIdeal::add(self : Self, other : FinIdeal) -> FinIdeal {
  let gens : Array[Array[Int32]] = []
  for x in self.members {
    gens.push(x)
  }
  for x in other.members {
    gens.push(x)
  }
  FinIdeal::generate(self.alg, gens)
}

///|
/// Product ideal `I·J = ⟨{a·b : a ∈ I, b ∈ J}⟩`.
pub fn FinIdeal::mul(self : Self, other : FinIdeal) -> FinIdeal {
  let gens : Array[Array[Int32]] = []
  for a in self.members {
    for b in other.members {
      gens.push(self.alg.mul_elem(a, b))
    }
  }
  FinIdeal::generate(self.alg, gens)
}

///|
/// Intersection `I ∩ J` as element-set intersection (exact for finite rings).
pub fn FinIdeal::intersect(self : Self, other : FinIdeal) -> FinIdeal {
  let out : Array[Array[Int32]] = []
  for x in self.members {
    if @linalg.elems_contains(other.members, x) {
      out.push(x)
    }
  }
  FinIdeal::{
    alg: self.alg,
    members: @linalg.elems_normalize(self.alg.p, out),
  }
}

///|
/// Ideal equality by canonical member lists.
pub fn FinIdeal::eq(self : Self, other : FinIdeal) -> Bool {
  @linalg.elems_eq(self.members, other.members)
}

///|
/// The quotient algebra `R/I` as an `𝔽_p`-algebra of dimension
/// `dim R − dim_k I`. Method: pick an F_p-basis of I, extend `1` to a
/// complement basis of R, and express every product of basis cosets in
/// that basis (unique solve — `basis ++ ibasis` is a full-rank square
/// system). Theorem: `dim_k R/I = dim_k R − dim_k I`.
pub fn FinIdeal::quotient(self : Self) -> FinAlg {
  let p = self.alg.p
  let dim_r = self.alg.dim
  if self.contains(self.alg.one_elem()) {
    abort("FinIdeal::quotient: unit ideal gives the zero ring")
  }
  let k = ideal_dim(self)
  let dim_q = dim_r - k
  // 1. F_p-basis of I (greedy independent subset of the member list)
  let ibasis : Array[Array[Int32]] = []
  let mut rows_i : Array[Array[Int32]] = []
  let mut rank_i = 0
  for x in self.members {
    if ibasis.length() == k {
      break
    }
    let cand : Array[Array[Int32]] = []
    for r in rows_i {
      cand.push(r)
    }
    cand.push(x)
    let rk = @linalg.Matrix::from_rows(p, cand).rank()
    if rk > rank_i {
      rows_i = cand
      rank_i = rk
      ibasis.push(x)
    }
  }
  // 2. complement basis of R over I, with 1 first (basis index 0)
  let basis : Array[Array[Int32]] = [self.alg.one_elem()]
  let mut rows : Array[Array[Int32]] = []
  for r in ibasis {
    rows.push(r)
  }
  rows.push(self.alg.one_elem())
  let mut rank_cur = @linalg.Matrix::from_rows(p, rows).rank()
  for x in self.alg.all_elements() {
    if basis.length() == dim_q {
      break
    }
    if @linalg.vec_eq(x, self.alg.one_elem()) {
      continue
    }
    let cand : Array[Array[Int32]] = []
    for r in rows {
      cand.push(r)
    }
    cand.push(x)
    let rk = @linalg.Matrix::from_rows(p, cand).rank()
    if rk > rank_cur {
      rows = cand
      rank_cur = rk
      basis.push(x)
    }
  }
  if basis.length() != dim_q || rank_cur != dim_r {
    abort("FinIdeal::quotient: complement basis construction failed")
  }
  // 3. coordinate solver: columns = basis ++ ibasis (dim_r independent
  //    columns spanning R), so every product has a unique decomposition
  let cols : Array[Array[Int32]] = []
  for c in basis {
    cols.push(c)
  }
  for c in ibasis {
    cols.push(c)
  }
  let mat = @linalg.Matrix::zero(p, dim_r, dim_r)
  for c in 0..<dim_r {
    for r in 0..<dim_r {
      mat.data[r][c] = cols[c][r]
    }
  }
  // 4. structure: mult-by-basis[i] in the quotient coordinates
  let mult : Array[@linalg.Matrix] = []
  for i in 0..<dim_q {
    let mi = @linalg.Matrix::zero(p, dim_q, dim_q)
    for j in 0..<dim_q {
      let prod = self.alg.mul_elem(basis[i], basis[j])
      let alpha = match mat.solve(prod) {
        Some(a) => a
        None =>
          abort("FinIdeal::quotient: product not in span (invariant violated)")
      }
      for l in 0..<dim_q {
        mi.data[l][j] = alpha[l]
      }
    }
    mult.push(mi)
  }
  let alg = FinAlg::{ p, dim: dim_q, mult, }
  if !alg.validate() {
    abort("FinIdeal::quotient: structure validation failed")
  }
  alg
}

///|
/// Is `P` a prime ideal? Direct definition: `∀a,b: a·b ∈ P ⇒ a ∈ P ∨ b ∈ P`,
/// with `P ≠ R`. Theorem: in a finite ring every prime ideal is maximal
/// (the quotient is a finite domain, hence a field).
pub fn FinIdeal::is_prime(self : Self) -> Bool {
  if self.members.length() == @num.power_int(self.alg.p, self.alg.dim) {
    return false // P = R is not prime
  }
  let all = self.alg.all_elements()
  for a in all {
    let ain = self.contains(a)
    for b in all {
      if !ain && !self.contains(b) {
        // both outside: their product must be outside
        let ab = self.alg.mul_elem(a, b)
        if self.contains(ab) {
          return false
        }
      }
    }
  }
  true
}

///|
/// All prime ideals (equivalently: maximal ideals, by finiteness).
pub fn prime_ideals(alg : FinAlg) -> Array[FinIdeal] {
  let out : Array[FinIdeal] = []
  for i in enumerate_ideals(alg) {
    if i.is_prime() {
      out.push(i)
    }
  }
  out
}

///|
/// All maximal ideals — identical to `prime_ideals` in a finite ring
/// (Theorem: finite ⇒ 0-dimensional ⇒ every prime is maximal).
pub fn maximal_ideals(alg : FinAlg) -> Array[FinIdeal] {
  prime_ideals(alg)
}

///|
/// Krull dimension: the length (number of strict inclusions) of the longest
/// chain of prime ideals, computed by DAG dynamic programming on `Spec R`.
pub fn krull_dim(alg : FinAlg) -> Int32 {
  let ps = prime_ideals(alg)
  let n = ps.length()
  if n == 0 {
    return -1 // Spec empty (zero ring only — not representable); return -1
  }
  // longest chain ending at each prime: dp[i] = 1 + max dp[j] over P_j ⊂ P_i
  let dp : Array[Int32] = []
  for _i in 0..<n {
    dp.push(1)
  }
  let mut best = 1
  // fixpoint relaxation (n rounds suffice for chains of length ≤ n)
  for _pass in 0..<n {
    for i in 0..<n {
      for j in 0..<n {
        if j == i {
          continue
        }
        // P_j ⊊ P_i ?
        let mut sub = true
        for x in ps[j].members {
          if !ps[i].contains(x) {
            sub = false
          }
        }
        if sub && ps[j].members.length() < ps[i].members.length() {
          if dp[j] + 1 > dp[i] {
            dp[i] = dp[j] + 1
          }
        }
      }
      if dp[i] > best {
        best = dp[i]
      }
    }
  }
  best - 1 // chain of k primes has length k − 1
}

///|
/// Is the ring local (unique maximal ideal)?
pub fn is_local(alg : FinAlg) -> Bool {
  maximal_ideals(alg).length() == 1
}

///|
/// The unique maximal ideal when the ring is local, `None` otherwise.
pub fn local_maximal(alg : FinAlg) -> FinIdeal? {
  let ms = maximal_ideals(alg)
  if ms.length() == 1 {
    Some(ms[0])
  } else {
    None
  }
}

///|
/// `dim_k I` for an ideal (rank of its member matrix over `𝔽_p`).
pub fn ideal_dim(i : FinIdeal) -> Int32 {
  if i.members.length() == 0 {
    return 0
  }
  @linalg.Matrix::from_rows(i.alg.p, i.members).rank()
}

///|
/// The product ideal `I² = ⟨{a·b : a,b ∈ I}⟩`.
pub fn square_ideal(i : FinIdeal) -> FinIdeal {
  i.mul(i)
}

///|
/// Embedding dimension of a local ring `(R, m)`: `dim_k(m/m²) = dim m − dim m²`.
/// Definition (regular local): `(R, m)` is regular iff `dim R = dim_k(m/m²)`.
pub fn embedding_dim(m : FinIdeal) -> Int32 {
  ideal_dim(m) - ideal_dim(square_ideal(m))
}

///|
/// Dimension of the *local ring* `R_m`: the longest prime chain `P ⊆ m`
/// (i.e. the Krull dimension of `R_m` computed from `Spec R`).
pub fn local_ring_dim(m : FinIdeal) -> Int32 {
  let alg = m.alg
  let ps = prime_ideals(alg)
  // primes contained in m
  let idx_of : Array[Int32] = []
  for _p in ps {
    idx_of.push(-1)
  }
  ignore(idx_of)
  let n = ps.length()
  let dp : Array[Int32] = []
  for _i in 0..<n {
    dp.push(1)
  }
  let mut best = 1
  for _pass in 0..<n {
    for i in 0..<n {
      let mut inside = true
      for x in ps[i].members {
        if !m.contains(x) {
          inside = false
        }
      }
      if !inside {
        continue
      }
      for j in 0..<n {
        if j == i {
          continue
        }
        let mut sub = true
        for x in ps[j].members {
          if !ps[i].contains(x) {
            sub = false
          }
        }
        let mut j_inside = true
        for x in ps[j].members {
          if !m.contains(x) {
            j_inside = false
          }
        }
        if sub && j_inside && ps[j].members.length() < ps[i].members.length() {
          if dp[j] + 1 > dp[i] {
            dp[i] = dp[j] + 1
          }
        }
      }
      if dp[i] > best {
        best = dp[i]
      }
    }
  }
  best - 1
}

///|
/// Is `R_m` a regular local ring? (local + `local dim = embedding dim`)
/// Fields count as regular local (`dim = embdim = 0`).
pub fn is_regular_local_at(m : FinIdeal) -> Bool {
  let alg = m.alg
  if !is_local(alg) {
    return false
  }
  match local_maximal(alg) {
    Some(mu) => {
      if !mu.eq(m) {
        return false
      }
      local_ring_dim(m) == embedding_dim(m)
    }
    None => false
  }
}

///|
/// Residual (conductor) ideal `(I : J) = { r ∈ R : r·J ⊆ I }` — a direct
/// finite scan, exact by definition. Special cases: `(I : 0) = R`,
/// `(R : J) = R`.
pub fn FinIdeal::conductor(self : Self, other : FinIdeal) -> FinIdeal {
  let out : Array[Array[Int32]] = []
  for r in self.alg.all_elements() {
    let mut ok = true
    for b in other.members {
      if !self.contains(self.alg.mul_elem(r, b)) {
        ok = false
      }
    }
    if ok {
      out.push(r)
    }
  }
  FinIdeal::{
    alg: self.alg,
    members: @linalg.elems_normalize(self.alg.p, out),
  }
}

///|
/// Annihilator of an element: `Ann(a) = { r : r·a = 0 }`.
pub fn annihilator(alg : FinAlg, a : Array[Int32]) -> FinIdeal {
  let out : Array[Array[Int32]] = []
  for r in alg.all_elements() {
    let ra = alg.mul_elem(r, a)
    let mut z = true
    for x in ra {
      if x != 0 {
        z = false
      }
    }
    if z {
      out.push(r)
    }
  }
  FinIdeal::{ alg, members: @linalg.elems_normalize(alg.p, out), }
}

///|
/// Annihilator of an ideal: `Ann(I) = { r : r·I = 0 }`.
pub fn annihilator_ideal(i : FinIdeal) -> FinIdeal {
  let alg = i.alg
  let out : Array[Array[Int32]] = []
  for r in alg.all_elements() {
    let mut kills = true
    for x in i.members {
      let rx = alg.mul_elem(r, x)
      for v in rx {
        if v != 0 {
          kills = false
        }
      }
    }
    if kills {
      out.push(r)
    }
  }
  FinIdeal::{ alg, members: @linalg.elems_normalize(alg.p, out), }
}

///|
/// Longest strictly descending chain of ideals (for the exhaustive DCC
/// witness on finite rings: finiteness of this number *is* the Artinian
/// property). Requires ideal enumeration — keep `p^dim` small.
pub fn longest_ideal_chain(alg : FinAlg) -> Int32 {
  let ids = enumerate_ideals(alg)
  let n = ids.length()
  // dp[i] = longest chain STARTING at ids[i] going down
  let dp : Array[Int32] = []
  for _i in 0..<n {
    dp.push(1)
  }
  let mut best = 1
  for _pass in 0..<n {
    for i in 0..<n {
      for j in 0..<n {
        if j == i {
          continue
        }
        // ids[j] ⊊ ids[i] (strict subset)
        let mut sub = true
        for x in ids[j].members {
          if !ids[i].contains(x) {
            sub = false
          }
        }
        if sub && ids[j].members.length() < ids[i].members.length() {
          if dp[j] + 1 > dp[i] {
            dp[i] = dp[j] + 1
          }
        }
      }
      if dp[i] > best {
        best = dp[i]
      }
    }
  }
  best
}
