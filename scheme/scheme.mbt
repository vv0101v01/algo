///|
/// The prime spectrum of a finite commutative ring, as a poset together
/// with its Zariski topology. Elements of `Spec R` are the prime ideals
/// (for finite rings: exactly the maximal ideals), ordered by inclusion.
pub(all) struct Spec {
  alg : @finite.FinAlg
  primes : Array[@finite.FinIdeal]
} derive(Debug)

///|
/// Build `Spec R` (prime enumeration via exhaustive ideal closure BFS).
pub fn spec(alg : @finite.FinAlg) -> Spec {
  Spec::{ alg, primes: @finite.prime_ideals(alg), }
}

///|
/// Inclusion order on `Spec`: `P ⊑ Q` iff `P ⊆ Q`.
pub fn Spec::is_le(self : Self, i : Int32, j : Int32) -> Bool {
  let p = self.primes[i]
  let q = self.primes[j]
  if p.members.length() > q.members.length() {
    return false
  }
  for x in p.members {
    if !q.contains(x) {
      return false
    }
  }
  true
}

///|
/// The basic open `D(f) = { P ∈ Spec R : f ∉ P }` as prime indices.
pub fn Spec::basic_open(self : Self, f : Array[Int32]) -> Array[Int32] {
  let out : Array[Int32] = []
  for k in 0..<self.primes.length() {
    if !self.primes[k].contains(f) {
      out.push(k)
    }
  }
  out
}

///|
/// All open sets of `Spec R` as distinct prime-subset masks, generated by
/// the basic opens under arbitrary union (finite) — deduplicated bitmasks.
/// Theorem: `D(fg) = D(f) ∩ D(g)` and the `D(f)` form a basis, so
/// OR-closure of the basic masks exhausts `τ(Zariski)` and `|τ| ≤ 2^|Spec|`.
pub fn Spec::opens(self : Self) -> Array[Bool] {
  let n = self.primes.length()
  let total = if n >= 31 { 31 } else { @num.power_int(2, n) }
  let seen : Array[Bool] = []
  for _m in 0..<total {
    seen.push(false)
  }
  // collect basic masks
  let masks : Array[Int32] = []
  for k in 0..<self.alg.all_elements().length() {
    let f = self.alg.all_elements()[k]
    let mut mask = 0
    for idx in self.basic_open(f) {
      mask = mask + @num.power_int(2, idx)
    }
    masks.push(mask)
  }
  // OR-closure (arbitrary unions of basics)
  let queue : Array[Int32] = [0]
  seen[0] = true
  let mut i = 0
  while i < queue.length() {
    let cur = queue[i]
    i = i + 1
    for m in masks {
      // bitwise OR via arithmetic (no operator overloading needed)
      let mut nxt = cur
      for idx in 0..<n {
        let mb = @num.mod_pos(m / @num.power_int(2, idx), 2)
        let cb = @num.mod_pos(cur / @num.power_int(2, idx), 2)
        if mb == 1 && cb == 0 {
          nxt = nxt + @num.power_int(2, idx)
        }
      }
      if !seen[nxt] {
        seen[nxt] = true
        queue.push(nxt)
      }
    }
  }
  seen
}

///|
/// Number of opens in the Zariski topology of `Spec R`.
pub fn Spec::open_count(self : Self) -> Int32 {
  let mut c = 0
  for x in self.opens() {
    if x {
      c = c + 1
    }
  }
  c
}

///|
/// The structure-sheaf restriction map `O(D(g)) → O(D(h))` whenever
/// `D(h) ⊆ D(g)` — computed on localization classes:
/// `a/g^j ↦ a·ι^{-j}` where `ι = g` inverted in `R_h`.
/// Returns the class table (length `|R_g|`) or `None` when the inclusion
/// of basic opens fails (no restriction map exists in general).
pub fn restriction(
  alg : @finite.FinAlg,
  g : Array[Int32],
  h : Array[Int32],
) -> Array[Int32]? {
  let sp = spec(alg)
  // require D(h) ⊆ D(g): h ∉ P ⇒ g ∉ P for every prime P
  for p in sp.primes {
    if !p.contains(h) && p.contains(g) {
      return None
    }
  }
  let loc_g = alg.localize_at_element(g)
  let loc_h = alg.localize_at_element(h)
  if loc_g.size() == 1 {
    // D(g) = ∅: the zero ring of sections maps into anything
    if loc_h.size() != 1 {
      return None
    }
    let t : Array[Int32] = []
    for _c in 0..<loc_g.size() {
      t.push(0)
    }
    return Some(t)
  }
  // inverse of g inside R_h (exists: D(h) ⊆ D(g) ⇒ g is a unit there)
  let g_h = loc_h.embed(g)
  let one_h = loc_h.embed(alg.one_elem())
  let mut inv = -1
  for y in 0..<loc_h.size() {
    if loc_h.mul_class(g_h, y) == one_h {
      inv = y
    }
  }
  if inv == -1 {
    return None // should not happen under the inclusion hypothesis
  }
  // powers of g for denominator exponents
  let powers : Array[Array[Int32]] = []
  let mut acc = alg.one_elem()
  let bound = @num.power_int(alg.p, alg.dim) + 1
  let mut k = 0
  while k <= bound {
    let mut seen = false
    for q in powers {
      if @linalg.vec_eq(q, acc) {
        seen = true
      }
    }
    if !seen {
      powers.push(acc)
    }
    acc = alg.mul_elem(acc, g)
    k = k + 1
  }
  let table : Array[Int32] = []
  for c in 0..<loc_g.size() {
    let rep = loc_g.class_pair[c]
    let a = loc_g.pair_num[rep]
    let den = loc_g.s_set[loc_g.pair_den[rep]]
    // exponent j with g^j = den
    let mut j = 0
    let mut found = -1
    for q in 0..<powers.length() {
      if @linalg.vec_eq(powers[q], den) {
        found = q
      }
    }
    if found == -1 {
      return None
    }
    j = found
    // image = embed(a) · inv^j
    let mut img = loc_h.embed(alg.all_elements()[a])
    let mut t = 0
    while t < j {
      img = loc_h.mul_class(img, inv)
      t = t + 1
    }
    table.push(img)
  }
  Some(table)
}

///|
fn apply_table(t : Array[Int32], c : Int32) -> Int32 {
  t[c]
}

///|
/// Cover test: does `D(h) ⊆ D(f) ∪ D(g)` hold?
pub fn covers_basic(
  alg : @finite.FinAlg,
  h : Array[Int32],
  f : Array[Int32],
  g : Array[Int32],
) -> Bool {
  let sp = spec(alg)
  for p in sp.primes {
    if !p.contains(h) && p.contains(f) && p.contains(g) {
      return false
    }
  }
  true
}

///|
/// The sheaf gluing axiom (Stacks-project-style on basic opens): for a
/// cover `D(h) ⊆ D(f) ∪ D(g)`, re-cover `D(h)` by `D(hf) ∪ D(hg)` and
/// check that every *agreeing* pair of sections
/// `u ∈ O(D(hf)), v ∈ O(D(hg))` (agreeing on the overlap `D(h²fg)`) is
/// the restriction of EXACTLY ONE section of `O(D(h))` — existence AND
/// uniqueness — and that distinct sections give distinct pairs
/// (bijection onto the agreeing fibre product).
pub fn sheaf_gluing_bijective(
  alg : @finite.FinAlg,
  h : Array[Int32],
  f : Array[Int32],
  g : Array[Int32],
) -> Bool {
  if !covers_basic(alg, h, f, g) {
    return false
  }
  let hf = alg.mul_elem(h, f)
  let hg = alg.mul_elem(h, g)
  let mut hfg = alg.mul_elem(hf, g)
  hfg = alg.mul_elem(hfg, h) // h²fg (overlap of the two covers)
  let res_hf = match restriction(alg, h, hf) {
    Some(t) => t
    None => return false
  }
  let res_hg = match restriction(alg, h, hg) {
    Some(t) => t
    None => return false
  }
  let res_a = match restriction(alg, hf, hfg) {
    Some(t) => t
    None => return false
  }
  let res_b = match restriction(alg, hg, hfg) {
    Some(t) => t
    None => return false
  }
  let loc_h = alg.localize_at_element(h)
  let loc_hf = alg.localize_at_element(hf)
  let loc_hg = alg.localize_at_element(hg)
  // count agreeing pairs and check each has exactly one preimage
  let mut agree_count = 0
  for u in 0..<loc_hf.size() {
    for v in 0..<loc_hg.size() {
      if apply_table(res_a, u) != apply_table(res_b, v) {
        continue
      }
      agree_count = agree_count + 1
      let mut preimages = 0
      for x in 0..<loc_h.size() {
        if apply_table(res_hf, x) == u && apply_table(res_hg, x) == v {
          preimages = preimages + 1
        }
      }
      if preimages != 1 {
        return false
      }
    }
  }
  agree_count == loc_h.size()
}

///|
/// Krull 維數（定義）：`dim Spec R` = 素理想嚴格包含鏈的最大長度
/// （`−1` 當 `R = 0`）。算法：按 `|P|` 升序（包含關係的拓撲序）做最長路 DP。
/// 定理：有限交換環上，`dim = |R|` 的正則環當且僅當各局部環正則且
/// `dim R = dim_k m/m²` 於所有閉點（見 `embedding_dim`）。
pub fn Spec::dimension(self : Self) -> Int32 {
  let n = self.primes.length()
  if n == 0 {
    return -1
  }
  // 按成員數升序排列（P ⊊ Q ⇒ |P| < |Q|，故為包含關係的拓撲序）
  let order : Array[Int32] = []
  for i in 0..<n {
    order.push(i)
  }
  // 插入排序（n 小）
  let a = order
  let mut i = 1
  while i < a.length() {
    let mut j = i
    while j > 0 &&
          self.primes[a[j]].members.length() >
          self.primes[a[j - 1]].members.length() {
      let tmp = a[j]
      a[j] = a[j - 1]
      a[j - 1] = tmp
      j = j - 1
    }
    i = i + 1
  }
  let dist : Array[Int32] = []
  for _i in 0..<n {
    dist.push(1)
  }
  let mut best = 1
  for idx in 0..<n {
    let pi = a[idx]
    for jdx in 0..<idx {
      let pj = a[jdx]
      // pj ⊆ pi 嚴格（大小嚴格遞增保證不相等）
      if self.is_le(pj, pi) && dist[pj] + 1 > dist[pi] {
        dist[pi] = dist[pj] + 1
      }
    }
    if dist[pi] > best {
      best = dist[pi]
    }
  }
  best - 1
}

///|
/// 不可約分支（定義）：`Spec R` 的不可約分支 ↔ 極小素理想。
/// 算法：取 `⊑`-極小元（不存在嚴格更小的素理想）。
/// 定理：極小素理想有限、準素分解的分支數 = `irreducible_components().length()`；
/// 環既約 ⟺ 極小素理想兩兩互異且 `nilradical = ∩ P_i`。
pub fn Spec::irreducible_components(self : Self) -> Array[Int32] {
  let n = self.primes.length()
  let out : Array[Int32] = []
  for i in 0..<n {
    let mut minimal = true
    for j in 0..<n {
      if i != j && self.is_le(j, i) && !self.is_le(i, j) {
        // pj ⊊ pi 嚴格 → pi 非極小
        minimal = false
      }
    }
    if minimal {
      out.push(i)
    }
  }
  out
}
